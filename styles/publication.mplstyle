# Publication style configuration for Nature / ACS / AIChE scientific figures
# LaTeX is optional; uses high-quality true-type fonts by default

# Font properties
font.family: sans-serif
font.sans-serif: Arial, DejaVu Sans, Helvetica, Liberation Sans, sans-serif
font.size: 8.0

# Axes properties
axes.linewidth: 0.8
axes.edgecolor: 0.15
axes.facecolor: white
axes.labelsize: 8.5
axes.labelcolor: 0.15
axes.titlesize: 9.0
axes.titleweight: bold
axes.titlepad: 4.0
axes.labelpad: 3.0
axes.prop_cycle: cycler('color', ['0072B2', 'D55E00', '009E73', 'CC79A7', 'F0E442', '56B4E9', 'E69F00', '000000'])
axes.spines.top: True
axes.spines.right: True

# Ticks
xtick.direction: in
ytick.direction: in
xtick.major.size: 3.5
ytick.major.size: 3.5
xtick.minor.size: 2.0
ytick.minor.size: 2.0
xtick.major.width: 0.75
ytick.major.width: 0.75
xtick.minor.width: 0.5
ytick.minor.width: 0.5
xtick.labelsize: 7.5
ytick.labelsize: 7.5
xtick.color: 0.15
ytick.color: 0.15
xtick.top: True
ytick.right: True

# Lines & markers
lines.linewidth: 1.2
lines.markersize: 4.0
lines.markeredgewidth: 0.6
lines.solid_capstyle: round

# Legend
legend.fontsize: 7.5
legend.title_fontsize: 7.5
legend.frameon: True
legend.framealpha: 0.9
legend.fancybox: False
legend.edgecolor: 0.8
legend.borderpad: 0.4
legend.labelspacing: 0.3
legend.handlelength: 1.5
legend.handletextpad: 0.5

# Figure
figure.facecolor: white
figure.edgecolor: white
figure.dpi: 300
figure.autolayout: False

# Vector and text rendering
text.usetex: False
mathtext.fontset: dejavusans
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none

# Saving figures
savefig.dpi: 300
savefig.facecolor: white
savefig.edgecolor: white
savefig.bbox: tight
savefig.pad_inches: 0.03
savefig.transparent: False
